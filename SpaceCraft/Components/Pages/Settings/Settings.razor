@page "/settings"
@inject SettingsService SettingsService
@inject KnowledgeService KnowledgeService
@inject TaskService TaskService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject NavigationHistoryService History
@using SpaceCraft.Services
@inject ThemeService ThemeService
@implements IDisposable

<PageTitle>Settings</PageTitle>

<div class="header">
    <h1>Настройки</h1>
    <div class="user-info">
        <span class="username">@currentUsername</span>
    </div>
</div>

<div class="settings-container">
    <div class="setting-item">
        <label class="setting-label">Тема</label>
        <div class="theme-toggle">
            <button class="theme-btn @(ThemeService.IsDarkTheme ? "active" : "")" 
                    @onclick="ToggleTheme">
                @if (ThemeService.IsDarkTheme)
                {
                    <span>🌙 Тёмная</span>
                }
                else
                {
                    <span>☀️ Светлая</span>
                }
            </button>
        </div>
    </div>

    <div class="settings-section">
        <h2>Настройки профиля</h2>
        <div class="form-group">
            <label for="username">Имя пользователя</label>
            <input type="text" id="username" @bind="username" class="form-input" />
        </div>
        <div class="form-group">
            <label for="password">Пароль</label>
            <input type="password" id="password" @bind="password" class="form-input" />
        </div>
        <button class="btn-primary @(isLoading ? "loading" : "")" @onclick="SaveSettings" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner"></span>
            }
            Сохранить изменения
        </button>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">@errorMessage</div>
        }
    </div>

    <div class="settings-section">
        <h2>Управление аккаунтом</h2>
        <button class="btn-danger" @onclick="ShowLogoutConfirmation">Выйти</button>
    </div>
</div>

@if (showLogoutDialog)
{
    <div class="modal-backdrop">
        <div class="modal-content">
            <h3 class="theme-text">Подтверждение выхода</h3>
            <p class="theme-text-muted">Вы уверены, что хотите выйти из аккаунта?</p>
            <div class="modal-buttons">
                <button class="btn-cancel" @onclick="CancelLogout">Отмена</button>
                <button class="btn-confirm" @onclick="ConfirmLogout">Выйти</button>
            </div>
        </div>
    </div>
}

@code {
    private string username = "";
    private string password = "";
    private bool showLogoutDialog = false;
    private string errorMessage = "";
    private bool isLoading = false;
    private string currentUsername = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUsername = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "username");
            Console.WriteLine($"Retrieved username from localStorage: {currentUsername}");
            
            if (string.IsNullOrEmpty(currentUsername))
            {
                var allData = await JSRuntime.InvokeAsync<string>("eval", "JSON.stringify(localStorage)");
                Console.WriteLine($"All localStorage data: {allData}");
            }
            await ThemeService.InitializeAsync();
            ThemeService.OnThemeChanged += OnThemeChanged;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting username: {ex}");
        }
    }

    private void OnThemeChanged(bool isDark)
    {
        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        if (isLoading) return;
        
        isLoading = true;
        errorMessage = "";
        
        try 
        {
            var (success, message) = await SettingsService.ChangeCredentialsAsync(username, password);
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "username", username);
                currentUsername = username;
            }
            else
            {
                errorMessage = message switch
                {
                    "No changes made." => "Вы ввели ваши текущие данные. Ничего не изменилось.",
                    "Username already taken." => "Пользователь с таким именем уже существует.",
                    "Имя пользователя не может быть пустым" => "Имя пользователя не может быть пустым",
                    "Пароль не может быть пустым" => "Пароль не может быть пустым",
                    _ => "Не удалось сохранить изменения. Проверьте введенные данные."
                };
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowLogoutConfirmation()
    {
        showLogoutDialog = true;
    }

    private void CancelLogout()
    {
        showLogoutDialog = false;
    }

    private async Task ConfirmLogout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.clear");

        KnowledgeService.ClearCache();
        TaskService.ClearCache();
        
        await History.ClearStackAsync();

        showLogoutDialog = false;
        Nav.NavigateTo("/login");
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}

<style>
    html, body {
        font-family: 'Open Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        background-color: var(--background-color);
        color: var(--text-primary);
    }
    .theme-text { color: var(--text-primary); margin: 0 0 8px 0; }
    .theme-text-muted { color: var(--text-secondary); margin: 0 0 16px 0; }
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding: 1rem;
        background: var(--surface-color);
        border-radius: 8px;
        box-shadow: 0 2px 4px var(--shadow-color);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--background-color);
        padding: 0.75rem 1.25rem;
        border-radius: 6px;
        box-shadow: 0 1px 3px var(--shadow-color);
        border: 1px solid var(--border-color);
    }

    .username {
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .user-info::before {
        content: "👤";
        font-size: 1.2rem;
    }

    .settings-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }

    .settings-section {
        background: var(--surface-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 4px var(--shadow-color);
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-input {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        margin-top: 0.5rem;
    }

    .btn-primary {
        background-color: var(--primary-color);
        color: var(--surface-color);
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-primary:hover {
        background-color: var(--primary-hover);
    }

    .btn-danger {
        background-color: var(--error-color);
        color: var(--surface-color);
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .btn-danger:hover {
        background-color: var(--error-hover);
    }

    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
    }

    .modal-content {
        background-color: var(--surface-color);
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 10px var(--shadow-color);
        max-width: 400px;
        width: 90%;
    }



    .error-message {
        color: red;
        margin-top: 1rem;
    }

    .btn-primary.loading {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        margin-right: 0.5rem;
        border: 2px solid #ffffff;
        border-radius: 50%;
        border-top-color: transparent;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .btn-cancel {
        background: var(--border-color);
        color: var(--surface-color);
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: var(--primary-hover) !important;
        color: var(--text-white);
    }

    .btn-confirm {
        background: var(--error-color);
        color: var(--surface-color);
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-confirm:hover {
        background: var(--primary-hover) !important;
        color: var(--text-white);
    }

    .modal-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 16px;
    }
</style>