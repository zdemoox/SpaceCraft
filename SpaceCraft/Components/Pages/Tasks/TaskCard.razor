@inject TaskService TaskService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NavigationHistoryService History

<div class="task-item">
    <span @onclick="() => OpenTask()" class="task-item-content">
        <span class="task-icon">📄</span>
        <span class="task-title">@TaskItem.Title</span>
    </span>

    <div class="task-actions">
        <button @onclick="() => TogglePin()" class="action-btn pin-btn" title="@(TaskItem.IsPinned ? "Открепить" : "Закрепить")">
            <span class="action-icon">@(TaskItem.IsPinned ? "📌❌" : "📌")</span>
        </button>
        <button @onclick="() => Edit()" class="action-btn edit-btn" title="Изменить название">
            <span class="action-icon">✏️</span>
        </button>
        <button @onclick="() => Delete()" class="action-btn delete-btn" title="Удалить">
            <span class="action-icon">🗑</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public TaskItem TaskItem { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private async Task Delete() => await OnDelete.InvokeAsync(TaskItem.Id);
    private async Task TogglePin()
    {
        await TaskService.TogglePin(TaskItem.Id);
        TaskItem.IsPinned = !TaskItem.IsPinned;
        StateHasChanged();
    }

    private async Task OpenTask()
    {
        var currentUrl = Nav.Uri.Replace(Nav.BaseUri, "/");
        await History.PushAsync(currentUrl);
        Nav.NavigateTo($"/task/edit/{TaskItem.Id}");
    }

    private async Task Edit()
    {
        try
        {
            var newTitle = await JS.InvokeAsync<string>("prompt", "Новое название", TaskItem.Title ?? "");
            if (!string.IsNullOrWhiteSpace(newTitle))
            {
                TaskItem.Title = newTitle;
                await TaskService.UpdateTask(TaskItem.Id, TaskItem.Title, TaskItem.Description ?? "");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка при редактировании: {ex.Message}");
            Console.WriteLine($"Error editing task: {ex}");
        }
    }
}

<style>
.task-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    margin-bottom: 0.5rem;
    background: var(--surface-color);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
}

.task-item:hover {
    background: var(--nav-hover);
    border-color: var(--primary-color);
}

.task-item-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    flex: 1;
    min-width: 0;
}

.task-item-content:hover .task-title {
    text-decoration: underline;
    color: var(--primary-color);
}

.task-icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
}

.task-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
}

.task-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
}

.action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
}

.action-btn:hover {
    background: var(--background-color);
    transform: scale(1.1);
}

.action-icon {
    font-size: 1.125rem;
    line-height: 1;
}

.pin-btn:hover {
    background: var(--warning-color);
}

.edit-btn:hover {
    background: var(--info-color);
}

.delete-btn:hover {
    background: var(--error-color);
}

.pin-btn:hover .action-icon,
.edit-btn:hover .action-icon,
.delete-btn:hover .action-icon {
    color: white;
}
</style>